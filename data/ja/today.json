い", "かい", ""], ["ます", "", ""], ["。", "", ""], ["まず", "", ""], ["は", "", ""], ["半導体", "はんどうたい", "半導体"], ["と", "", ""], ["AI", "", ""], ["の", "", ""], ["サプライチェーン", "", "サプライチェーン"], ["です", "", ""], ["。", "", ""], ["これ", "", ""], ["ら", "", ""], ["は", "", ""], ["アメリカ", "", ""], ["の", "", ""], ["力強い", "ちからづよい", "力強い"], ["投資", "とうし", "投資"], ["の", "", ""], ["恩恵", "おんけい", "恩恵"], ["を", "", ""], ["受け", "うけ", ""], ["て", "", ""], ["い", "", ""], ["ます", "", ""], ["。", "", ""], ["内需", "ないじゅ", "内需"], ["に", "", ""], ["頼る", "たよる", ""], ["企業", "きぎょう", "企業"], ["や", "", ""], ["負債", "ふさい", "負債"], ["の", "", ""], ["多い", "おおい", ""], ["企業", "きぎょう", "企業"], ["に", "", ""], ["は", "", ""], ["慎重", "しんちょう", "慎重"], ["に", "", ""], ["なり", "", ""], ["ます", "", ""], ["。", "", ""]]}}, {"who": "ウォール街の投資家 · 월가 투자자", "ja": "ドル高は、中国資産に対するあなたの見方をどう変えますか？", "ko": "달러 강세가 중국 자산에 대한 견해를 어떻게 바꾸나요?", "audio": "data/audio/ja/2026-10-30/q4.mp4", "seg": [["ドル高", "どるだか", "ドル高"], ["は", "", ""], ["、", "", ""], ["中国", "ちゅうごく", ""], ["資産", "しさん", "資産"], ["に", "", ""], ["対する", "たいする", ""], ["あなた", "", ""], ["の", "", ""], ["見方", "みかた", "見方"], ["を", "", ""], ["どう", "", ""], ["変え", "かえ", ""], ["ます", "", ""], ["か", "", ""], ["？", "", ""]], "model": {"ja": "ドル高によって、私は中国市場で銘柄をより厳選するようになっています。人民元が弱くなるため、中国人民銀行の利下げの余地が狭まるからです。ですから海外で稼ぐ中国企業をより選好し、内需セクターは財政支援がもっと出るまで待ちます。", "ko": "달러 강세 때문에 저는 중국 시장에서 더 골라서 투자합니다. 인민은행의 금리 인하 여지가 줄어듭니다. 위안화가 약해지기 때문입니다. 그래서 해외에서 돈을 버는 중국 기업을 더 선호하고, 내수 업종은 재정 지원이 더 나올 때까지 기다리겠습니다.", "audio": "data/audio/ja/2026-10-30/model4.mp4", "seg": [["ドル高", "どるだか", "ドル高"], ["に", "", ""], ["よっ", "", ""], ["て", "", ""], ["、", "", ""], ["私", "わたくし", ""], ["は", "", ""], ["中国", "ちゅうごく", ""], ["市場", "しじょう", "市場"], ["で", "", ""], ["銘柄", "めいがら", "銘柄"], ["を", "", ""], ["より", "", ""], ["厳選", "げんせん", "厳選"], ["する", "", ""], ["よう", "", ""], ["に", "", ""], ["なっ", "", ""], ["て", "", ""], ["い", "", ""], ["ます", "", ""], ["。", "", ""], ["人民元", "じんみんもと", "人民元"], ["が", "", ""], ["弱く", "よわく", ""], ["なる", "", ""], ["ため", "", ""], ["、"