", "ど", ""], ["に", "", ""], ["起き", "おき", ""], ["まし", "", ""], ["た", "", ""], ["。", "", ""], ["AI", "", ""], ["取引", "とりひき", ""], ["は", "", ""], ["人気", "にんき", ""], ["が", "", ""], ["集中", "しゅうちゅう", "集中"], ["し", "", ""], ["すぎ", "", ""], ["て", "", ""], ["い", "", ""], ["て", "", ""], ["、", "", ""], ["バリュエーション", "", "バリュエーション"], ["も", "", ""], ["とても", "", ""], ["高かっ", "たかかっ", ""], ["た", "", ""], ["です", "", ""], ["。", "", ""], ["金利", "きんり", "金利"], ["は", "", ""], ["5", "", ""], ["%", "", ""], ["近く", "ちかく", ""], ["に", "", ""], ["とどまり", "", ""], ["、", "", ""], ["FRB", "", "FRB"], ["は", "", ""], ["追加利上げ", "ついかりあげ", "追加利上げ"], ["に", "", ""], ["言及", "げんきゅう", ""], ["し", "", ""], ["まし", "", ""], ["た", "", ""], ["。", "", ""], ["そこ", "", ""], ["に", "", ""], ["エヌビディア", "", "エヌビディア"], ["の", "", ""], ["ニュース", "", ""], ["が", "", ""], ["、", "", ""], ["主役", "しゅやく", "主役"], ["へ", "", ""], ["の", "", ""], ["信頼", "しんらい", "信頼"], ["を", "", ""], ["揺さぶり", "ゆさぶり", "揺さぶる"], ["まし", "", ""], ["た", "", ""], ["。", "", ""], ["主役", "しゅやく", "主役"], ["が", "", ""], ["崩れる", "くずれる", "崩れる"], ["と", "", ""], ["、", "", ""], ["すべて", "", ""], ["が", "", ""], ["つら", "", ""], ["れ", "", ""], ["て", "", ""], ["下がり", "さがり", ""], ["ます", "", ""], ["。", "", ""], ["恐怖", "きょうふ", "恐怖"], ["が", "", ""], ["調整", "ちょうせい", "調整"], ["を", "", ""], ["暴落", "ぼうらく", "暴落"], ["に", "", ""], ["変え", "かえ", ""], ["まし", "", ""], ["た", "", ""], ["。", "", ""]]}}, {"who": "経済キャスター · 경제 앵커", "ja": "エヌビディアの会計に関する報道はどれほど深刻ですか？", "ko": "엔비디아 회계에 관한 보도는 얼마나 심각한가요?", "audio": "data/audio/ja/2026-11-22/q1.mp4", "seg": [["エヌビディア", "", "エヌビディア"], ["の", "", ""], ["会計", "かいけい", "会計"], ["に", "", ""], ["関する", "かんする", ""], ["報道", "ほうどう", "報道"], ["は", "", ""], ["どれ", "", ""], ["ほど", "", ""], ["深刻", "しんこく", "深刻"], ["です", "", ""], ["か", "", ""], ["？", "", ""]], "model": {"ja": "これは結論ではなく報道なので、慎重になるべきです。調査は、誰かが悪いことをしたという意味ではありません。しかし、これほど大きな企業にとって信頼がすべてです。投資家はエヌビディアから早くはっきりした答えを求めています。それまでは株価が大きく揺れ続けるでしょう。事業そのものはまだとても強いです。", "ko": "이것은 결론이 아니라 보도이기 때문에 신중해야 합니다. 조사가 누군가 잘못했다