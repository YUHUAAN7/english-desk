io": "data/audio/ja/2026-11-16/model2.mp4", "seg": [["はい", "", ""], ["、", "", ""], ["で", "", ""], ["も", "", ""], ["工場", "こうじょう", "工場"], ["を", "", ""], ["増やす", "ふやす", ""], ["の", "", ""], ["で", "", ""], ["は", "", ""], ["なく", "", ""], ["、", "", ""], ["家計", "かけい", "家計"], ["を", "", ""], ["対象", "たいしょう", ""], ["に", "", ""], ["す", "", ""], ["べき", "", ""], ["です", "", ""], ["。", "", ""], ["家族", "かぞく", ""], ["へ", "", ""], ["の", "", ""], ["現金支援", "げんきんしえん", "現金支援"], ["や", "", ""], ["、", "", ""], ["より", "", ""], ["良い", "よい", ""], ["社会", "しゃかい", ""], ["の", "", ""], ["セーフティーネット", "", "セーフティーネット"], ["が", "", ""], ["役", "やく", ""], ["に", "", ""], ["立つ", "たつ", ""], ["でしょう", "", ""], ["。", "", ""], ["不動産", "ふどうさん", "不動産"], ["市場", "しじょう", "市場"], ["を", "", ""], ["立て直す", "たてなおす", ""], ["こと", "", ""], ["も", "", ""], ["大切", "たいせつ", ""], ["です", "", ""], ["。", "", ""], ["橋", "はし", ""], ["や", "", ""], ["道路", "どうろ", ""], ["を", "", ""], ["もっと", "", ""], ["作っ", "つくっ", ""], ["て", "", ""], ["も", "", ""], ["、", "", ""], ["弱い", "よわい", ""], ["信頼", "しんらい", "信頼"], ["は", "", ""], ["解決", "かいけつ", "解決"], ["し", "", ""], ["ませ", "", ""], ["ん", "", ""], ["。", "", ""], ["中国", "ちゅうごく", ""], ["政府", "せいふ", ""], ["に", "", ""], ["は", "", ""], ["手段", "しゅだん", "手段"], ["が", "", ""], ["あり", "", ""], ["ます", "", ""], ["。", "", ""], ["問題", "もんだい", ""], ["は", "", ""], ["意志", "いし", "意志"], ["が", "", ""], ["ある", "", ""], ["か", "", ""], ["どう", "", ""], ["か", "", ""], ["です", "", ""], ["。", "", ""]]}}, {"who": "ウォール街の投資家 · 월가 투자자", "ja": "今は中国株に投資するいい時期ですか？", "ko": "지금 중국 주식에 투자하기 좋은 때인가요?", "audio": "data/audio/ja/2026-11-16/q3.mp4", "seg": [["今", "いま", ""], ["は", "", ""], ["中国", "ちゅうごく", ""], ["株", "かぶ", ""], ["に", "", ""], ["投資", "とうし", "投資"], ["する", "", ""], ["いい", "", ""], ["時期", "じき", "時期"], ["です", "", ""], ["か", "", ""], ["？", "", ""]], "model": {"ja": "選んで投資するなら、はい。中国株はアメリカ株に比べて割安です。今年は一部のテクノロジー、電気自動車、輸出企業が好調です。しかし、消費と不動産の分野はまだリスクがあります。私は比率を小さくして、本格的な景気刺激策を待ちます。安いものは、いつでもさらに安くなりえます。", "ko": "선별적으로는 그렇습니다. 중국 주식은 미국 주식에 비해 쌉