두가 같은 주식을 갖고 있을 때는 좋은 소식도 매도를 막지 못합니다.", "audio": "data/audio/ja/2026-11-21/model0.mp4", "seg": [["問題", "もんだい", ""], ["は", "", ""], ["利益", "りえき", "利益"], ["で", "", ""], ["は", "", ""], ["なく", "", ""], ["、", "", ""], ["価格", "かかく", "価格"], ["だ", "", ""], ["から", "", ""], ["です", "", ""], ["。", "", ""], ["投資家", "とうしか", "投資家"], ["は", "", ""], ["将来", "しょうらい", "将来"], ["の", "", ""], ["成長", "せいちょう", "成長"], ["に", "", ""], ["高", "たか", ""], ["すぎる", "", ""], ["お", "", ""], ["金", "かね", "金"], ["を", "", ""], ["払い", "はらい", ""], ["まし", "", ""], ["た", "", ""], ["。", "", ""], ["今", "いま", ""], ["は", "", ""], ["金利", "きんり", "金利"], ["が", "", ""], ["高く", "たかく", ""], ["、", "", ""], ["FRB", "", "FRB"], ["は", "", ""], ["また", "", ""], ["利上げ", "りあげ", "利上げ"], ["する", "", ""], ["か", "", ""], ["も", "", ""], ["しれ", "", ""], ["ませ", "", ""], ["ん", "", ""], ["。", "", ""], ["その", "", ""], ["ため", "", ""], ["投資家", "とうしか", "投資家"], ["は", "", ""], ["、", "", ""], ["最も", "もっとも", ""], ["上がっ", "あがっ", ""], ["た", "", ""], ["銘柄", "めいがら", "銘柄"], ["で", "", ""], ["利益確定", "りえきかくてい", "利益確定"], ["を", "", ""], ["し", "", ""], ["て", "", ""], ["い", "", ""], ["ます", "", ""], ["。", "", ""], ["人気", "にんき", ""], ["が", "", ""], ["集中", "しゅうちゅう", "集中"], ["し", "", ""], ["た", "", ""], ["取引", "とりひき", ""], ["ほど", "", ""], ["大きく", "おおきく", ""], ["下がり", "さがり", ""], ["ます", "", ""], ["。", "", ""], ["みんな", "", ""], ["が", "", ""], ["同じ", "おなじ", ""], ["株", "かぶ", ""], ["を", "", ""], ["持っ", "もっ", ""], ["て", "", ""], ["いる", "", ""], ["とき", "", ""], ["は", "", ""], ["、", "", ""], ["良い", "よい", ""], ["ニュース", "", ""], ["も", "", ""], ["売り", "うり", "売り"], ["を", "", ""], ["止め", "とめ", ""], ["られ", "", ""], ["ませ", "", ""], ["ん", "", ""], ["。", "", ""]]}}, {"who": "経済キャスター · 경제 앵커", "ja": "S&P500は調整局面に入りました。これは弱気相場の始まりですか？", "ko": "S&P 500이 조정 국면입니다. 이것이 약세장의 시작인가요?", "audio": "data/audio/ja/2026-11-21/q1.mp4", "seg": [["S", "", ""], ["&", "", ""], ["P", "", ""], ["500", "", ""], ["は", "", ""], ["調整局面", "ちょうせいきょくめん", "調整局面"], ["に", "", ""], ["入り", "はいり", ""], ["まし", 