だけ", "", ""], ["判断", "はんだん", "判断"], ["する", "", ""], ["と", "", ""], ["すれ", "", ""], ["ば", "", ""], ["、", "", ""], ["これ", "", ""], ["です", "", ""], ["。", "", ""]]}, {"set": "무기 문장 · 전망과 마무리", "ja": "ですから投資家の皆さんへのアドバイスは、忍耐強く、銘柄を厳選することです。", "ko": "그래서 투자자들께 드리는 조언은, 인내심을 갖고 골라서 사라는 것입니다.", "audio": "data/audio/ja/weapons/w22.mp4", "seg": [["です", "", ""], ["から", "", ""], ["投資家", "とうしか", "投資家"], ["の", "", ""], ["皆", "みな", ""], ["さん", "", ""], ["へ", "", ""], ["の", "", ""], ["アドバイス", "", ""], ["は", "", ""], ["、", "", ""], ["忍耐", "にんたい", "忍耐"], ["強く", "つよく", ""], ["、", "", ""], ["銘柄", "めいがら", "銘柄"], ["を", "", ""], ["厳選", "げんせん", "厳選"], ["する", "", ""], ["こと", "", ""], ["です", "", ""], ["。", "", ""]]}], "questions": [{"who": "経済キャスター · 경제 앵커", "ja": "中国の消費者はなぜまだお金を使わないのですか？", "ko": "중국 소비자들은 왜 여전히 돈을 쓰지 않나요?", "audio": "data/audio/ja/2026-11-16/q0.mp4", "seg": [["中国", "ちゅうごく", ""], ["の", "", ""], ["消費者", "しょうひしゃ", "消費者"], ["は", "", ""], ["なぜ", "", ""], ["まだ", "", ""], ["お", "", ""], ["金", "かね", "金"], ["を", "", ""], ["使わ", "つかわ", ""], ["ない", "", ""], ["の", "", ""], ["です", "", ""], ["か", "", ""], ["？", "", ""]], "model": {"ja": "家計が将来を心配しているからです。住宅価格は何年も下がっていて、家は彼らの主な貯蓄です。若者は仕事のことも心配しています。だから家族はお金を使わずに貯金します。工場は生産を続けていますが、国内の需要は弱いです。その差が核心的な問題です。", "ko": "가계가 미래를 걱정하기 때문입니다. 집값이 몇 년째 떨어졌고, 집은 그들의 주된 저축입니다. 젊은이들은 일자리도 걱정합니다. 그래서 가족들은 쓰는 대신 저축합니다. 공장은 계속 생산하지만 국내 수요는 약합니다. 그 격차가 핵심 문제입니다.", "audio": "data/audio/ja/2026-11-16/model0.mp4", "seg": [["家計", "かけい", "家計"], ["が", "", ""], ["将来", "しょうらい", "将来"], ["を", "", ""], ["心配", "しんぱい", "心配"], ["し", "", ""], ["て", "", ""], ["いる", "", ""], ["から", "", ""], ["です", "", ""], ["。", "", ""], ["住宅価格", "じゅうたくかかく", "住宅価格"], ["は", "", ""], ["何", "なん", ""], ["年", "ねん", ""], ["も", "", ""], ["下がっ", "さがっ", ""], ["て", "", ""], ["い", "", ""], ["て", "", ""], ["、", "", ""], ["家", "いえ", ""], ["は", "", ""], ["彼", "かれ", ""], ["ら", "", ""], ["の", "", ""], ["主な", "おもな", ""], ["貯蓄", "ちょちく", "貯蓄"], ["です", "", ""], ["。", "", ""], ["若者", "わかもの", "若者"], ["は", "", ""