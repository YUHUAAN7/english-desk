", "", ""], ["間違っ", "まちがっ", ""], ["た", "", ""], ["方向", "ほうこう", "方向"], ["に", "", ""], ["動い", "うごい", ""], ["て", "", ""], ["い", "", ""], ["ます", "", ""], ["。", "", ""], ["特に", "とくに", ""], ["成長率", "せいちょうりつ", "成長率"], ["が", "", ""], ["4.3", "", ""], ["%", "", ""], ["で", "", ""], ["は", "", ""], ["、", "", ""], ["FRB", "", "FRB"], ["は", "", ""], ["それ", "", ""], ["を", "", ""], ["無視", "むし", "無視"], ["でき", "", ""], ["ませ", "", ""], ["ん", "", ""], ["。", "", ""], ["0.25", "", ""], ["%", "", ""], ["の", "", ""], ["利上げ", "りあげ", "利上げ"], ["が", "", ""], ["かなり", "", ""], ["有力", "ゆうりょく", "有力"], ["に", "", ""], ["見え", "みえ", ""], ["ます", "", ""], ["。", "", ""], ["より", "", ""], ["大きな", "おおきな", ""], ["問題", "もんだい", ""], ["は", "", ""], ["1", "", ""], ["月", "がつ", ""], ["です", "", ""], ["。", "", ""], ["FRB", "", "FRB"], ["は", "", ""], ["来年", "らいねん", ""], ["まで", "", ""], ["利上げ", "りあげ", "利上げ"], ["を", "", ""], ["続ける", "つづける", ""], ["か", "", ""], ["も", "", ""], ["しれ", "", ""], ["ませ", "", ""], ["ん", "", ""], ["。", "", ""]]}}, {"who": "経済キャスター · 경제 앵커", "ja": "韓国は米国の新しい関税計画をどれほど心配すべきですか？", "ko": "한국은 미국의 새 관세 계획을 얼마나 걱정해야 하나요?", "audio": "data/audio/ja/2026-11-26/q1.mp4", "seg": [["韓国", "かんこく", ""], ["は", "", ""], ["米国", "べいこく", ""], ["の", "", ""], ["新しい", "あたらしい", ""], ["関税", "かんぜい", "関税"], ["計画", "けいかく", "計画"], ["を", "", ""], ["どれ", "", ""], ["ほど", "", ""], ["心配", "しんぱい", "心配"], ["す", "", ""], ["べき", "", ""], ["です", "", ""], ["か", "", ""], ["？", "", ""]], "model": {"ja": "韓国は真剣に受け止めるべきですが、まだ提案にすぎません。意見の提出は1月初めまでで、公聴会はその月の後半に始まります。交渉する時間はあります。しかし半導体と自動車はより高いコストに直面するかもしれません。韓国企業には今、はっきりした計画が必要です。政府は素早く動かなければなりません。", "ko": "한국은 진지하게 받아들여야 하지만 아직은 제안일 뿐입니다. 의견 제출은 1월 초까지이고, 공청회는 그달 말에 시작됩니다. 협상할 시간이 있습니다. 하지만 반도체와 자동차는 더 높은 비용에 직면할 수 있습니다. 한국 기업들은 지금 분명한 계획이 필요합니다. 정부는 빠르게 움직여야 합니다.", "audio": "data/audio/ja/2026-11-26/model1.mp4", "seg": [["韓国", "かんこく", ""], ["は", "", ""], ["真剣", "しんけん", ""], ["に", "", ""], ["受け止める", "うけとめる", ""], ["べき", "", ""], ["です", "", ""], ["が", "", ""], ["、", "", ""], ["まだ", "", ""], 